#!/usr/bin/env bash
# Launch Calamares from the Live Plasma session.
#
# The Live user has passwordless sudo. The rule and the user are removed from
# the installed target by the Calamares post-install scripts.
set -eu

if [[ "$(id -u)" -eq 0 ]]; then
    exec /usr/bin/calamares "$@"
fi

if sudo -n true 2>/dev/null; then
    exec sudo -E /usr/bin/calamares "$@"
fi

exec pkexec /usr/bin/calamares "$@"
